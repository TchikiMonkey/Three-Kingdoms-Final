Dialogue: 0,0:26:19.03,0:26:23.27,Thinking,,0,0,0,,{\bord12\pos(640,660)}We swear this oath.
Dialogue: 0,0:26:23.27,0:26:27.58,Thinking,,0,0,0,,{\bord12\pos(640,660)}A companionship brought on by spring breeze.
Dialogue: 0,0:26:27.58,0:26:36.11,Thinking,,0,0,0,,{\bord12\pos(640,660)}Peach blossoms bloom before the altar.
Dialogue: 0,0:26:36.11,0:26:40.32,Thinking,,0,0,0,,{\bord12\pos(640,660)}We swear this oath.
Dialogue: 0,0:26:40.32,0:26:44.57,Thinking,,0,0,0,,{\bord12\pos(640,660)}Defend the nation to bring peace and magnanimity,
Dialogue: 0,0:26:44.57,0:26:48.85,Thinking,,0,0,0,,{\bord12\pos(640,660)}Let us show our talents in making an impact,
Dialogue: 0,0:26:48.85,0:26:55.15,Thinking,,0,0,0,,{\bord12\pos(640,660)}show our talents.
Dialogue: 0,0:26:55.15,0:26:59.37,Thinking,,0,0,0,,{\bord12\pos(640,660)}We swear this oath!
Dialogue: 0,0:26:59.37,0:27:03.76,Thinking,,0,0,0,,{\bord12\pos(640,660)}Loyalty and justice are our values!
Dialogue: 0,0:27:03.76,0:27:08.02,Thinking,,0,0,0,,{\bord12\pos(640,660)}Following each other into hardship,
Dialogue: 0,0:27:08.02,0:27:12.13,Thinking,,0,0,0,,{\bord12\pos(640,660)}we swear to never part!
Dialogue: 0,0:27:12.13,0:27:16.41,Thinking,,0,0,0,,{\bord12\pos(640,660)}We swear this oath!
Dialogue: 0,0:27:16.41,0:27:20.63,Thinking,,0,0,0,,{\bord12\pos(640,660)}In life or death, we will never falter.
Dialogue: 0,0:27:20.63,0:27:22.90,Thinking,,0,0,0,,{\bord12\pos(640,660)}Heaven and Earth, Sun and Moon,
Dialogue: 0,0:27:22.90,0:27:29.84,Thinking,,0,0,0,,{\bord12\pos(640,660)}strengthen our friendship!
Dialogue: 0,0:27:48.90,0:27:51.58,Thinking,,0,0,0,,{\bord12\pos(640,660)}Long spears in hand!
Dialogue: 0,0:27:51.58,0:27:54.20,Thinking,,0,0,0,,{\bord12\pos(640,660)}Swords shining brilliantly!
Dialogue: 0,0:27:54.20,0:27:56.87,Thinking,,0,0,0,,{\bord12\pos(640,660)}Look my brothers!
Dialogue: 0,0:27:56.87,0:27:59.47,Thinking,,0,0,0,,{\bord12\pos(640,660)}Onwards as the fire beckons us!
Dialogue: 0,0:27:59.47,0:28:02.16,Thinking,,0,0,0,,{\bord12\pos(640,660)}Long spears in hand!
Dialogue: 0,0:28:02.16,0:28:04.80,Thinking,,0,0,0,,{\bord12\pos(640,660)}Swords shining brilliantly!
Dialogue: 0,0:28:04.80,0:28:07.51,Thinking,,0,0,0,,{\bord12\pos(640,660)}Look my brothers!
Dialogue: 0,0:28:07.51,0:28:10.07,Thinking,,0,0,0,,{\bord12\pos(640,660)}Onwards as the fire beckons us!
